<title>Finanças Pessoais — Rafael Linhares</title>

<style>

/* =========================================================
   BASE
========================================================= */

* {
  box-sizing: border-box;
}

html,
body {
  margin: 0;
  padding: 0;
  width: 100%;
  background: transparent;
  font-size: 115%;
}

body {
  font-family: Arial, sans-serif;
  color: #111111;
}


/* =========================================================
   PALETA
========================================================= */

:root {
  --preto: #0b0b0b;
  --preto-suave: #25282a;

  --cinza: #c8d2d8;
  --cinza-claro: #e8edf1;
  --cinza-fundo: #f4f6f7;

  --azul-metal: #2f5d7c;
  --azul-escuro: #17324d;
  --azul-claro: #4b7591;

  --texto: #353637;
  --texto-suave: #626d72;
}


/* =========================================================
   CONTAINER
========================================================= */

.rl-guide {
  width: 100%;
  max-width: 1120px;
  margin: 0 auto;
  padding: 0 28px 40px;
}


/* =========================================================
   CABEÇALHO
========================================================= */

.rl-guide-header {
  margin-bottom: 28px;
}

.rl-guide-label {
  margin-bottom: 9px;

  color: var(--azul-metal);

  font-size: .68rem;
  font-weight: 700;

  letter-spacing: .16em;
  text-transform: uppercase;
}

.rl-guide-header h2 {
  position: relative;

  margin: 0;
  padding-bottom: 17px;

  color: var(--preto);

  font-size: clamp(2.2rem, 4vw, 3.3rem);
  line-height: 1.03;
  font-weight: 700;

  letter-spacing: -.045em;
}

.rl-guide-header h2::after {
  content: "";

  position: absolute;

  left: 0;
  bottom: 0;

  width: 48px;
  height: 2px;

  background: var(--azul-metal);

  border-radius: 2px;
}


/* =========================================================
   BLOCOS EXPANSÍVEIS (DISCRETOS E MENORES)
========================================================= */

.rl-detail {
  border-top: 1px solid var(--cinza);
  margin-bottom: 0;
}

.rl-detail:last-of-type {
  border-bottom: 1px solid var(--cinza);
}

.rl-detail summary {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 44px; /* Mais compacto */
  padding: 10px 32px 10px 0;
  color: var(--texto-suave); /* Mais discreto */
  font-size: 0.8rem; /* Menor */
  font-weight: 600;
  cursor: pointer;
  list-style: none;
}

.rl-detail summary::-webkit-details-marker {
  display: none;
}

.rl-detail summary::after {
  content: "";
  position: absolute;
  right: 6px;
  top: 50%;
  width: 5px;
  height: 5px;
  border-right: 1.2px solid #88959c;
  border-bottom: 1.2px solid #88959c;
  transform: translateY(-65%) rotate(45deg);
  transition: .2s ease;
}

.rl-detail[open] summary {
  color: var(--azul-metal);
}

.rl-detail[open] summary::after {
  transform: translateY(-20%) rotate(225deg);
}

.rl-detail-content {
  padding: 0 35px 16px 0;
}

.rl-detail-content p {
  max-width: 900px;
  margin: 0 0 10px;
  color: var(--texto-suave);
  font-size: 0.78rem;
  line-height: 1.6;
}

.rl-detail-content p:last-child {
  margin-bottom: 0;
}

.rl-detail-content strong {
  color: var(--preto);
}

/* Estilo para caixas internas de destaque unificadas */
.rl-privacy,
.rl-json {
  margin: 0 0 12px;
  padding: 16px 18px;
  background: var(--cinza-fundo);
  border-left: 2px solid var(--azul-metal);
}

.rl-privacy:last-child,
.rl-json:last-child {
  margin-bottom: 0;
}

.rl-privacy p,
.rl-json p {
  color: var(--texto-suave);
  font-size: 0.78rem;
  line-height: 1.6;
  margin: 0 0 8px;
}

.rl-privacy p:last-child,
.rl-json p:last-child {
  margin-bottom: 0;
}

.rl-privacy strong,
.rl-json strong {
  color: var(--preto);
}

/* =========================================================
   VÍDEO EXPLICATIVO
========================================================= */

.rl-video-container {
  margin-top: 8px;
  padding: 16px 18px;
  background: var(--cinza-fundo);
  border-left: 2px solid var(--azul-metal);
}

.rl-video-container iframe {
  width: 100%;
  aspect-ratio: 16 / 9;
  border: 0;
  border-radius: 4px;
}


/* =========================================================
   RESPONSIVO
========================================================= */

@media (max-width: 900px) {

  .rl-guide {
    padding-left: 24px;
    padding-right: 24px;
  }

}


@media (max-width: 600px) {

  html,
  body {
    font-size: 110%;
  }

  .rl-guide {
    padding: 0 17px 30px;
  }

  .rl-guide-header {
    margin-bottom: 23px;
  }

  .rl-guide-label {
    font-size: .62rem;
  }

  .rl-guide-header h2 {
    padding-bottom: 13px;
    font-size: 2.1rem;
  }

  .rl-detail summary {
    min-height: 40px;
    padding-right: 28px;
    font-size: 0.75rem;
  }

  .rl-detail-content {
    padding-right: 15px;
    padding-bottom: 16px;
  }

  .rl-detail-content p {
    font-size: 0.7rem;
    line-height: 1.55;
  }

}


@media (max-width: 380px) {

  .rl-guide {
    padding-left: 14px;
    padding-right: 14px;
  }

  .rl-guide-header h2 {
    font-size: 1.9rem;
  }

}


/* =========================================================
   AJUSTES PARA A PÁGINA COM CABEÇALHO E RODAPÉ
========================================================= */

body { background: #ffffff; }
.rl-guide { padding-top: 56px; }
.rl-footer { margin-top: 32px; }

@media (max-width: 600px) {
  .rl-guide { padding-top: 40px; }
}

@media print {
  .rl-header, .rl-footer { display: none; }
}

    /* =====================================================
        CABEÇALHO E RODAPÉ (MINIMALISTAS)
    ===================================================== */

    .rl-header,
    .rl-footer {
      background: #000000;
      color: #ffffff;
      font-family: "IBM Plex Sans", "Segoe UI", system-ui, -apple-system, Helvetica, Arial, sans-serif;
    }

    .rl-header {
      position: sticky;
      top: 0;
      z-index: 50;
      padding-top: env(safe-area-inset-top);
    }

    .rl-header-inner {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      max-width: 1280px;
      height: 64px;
      margin: 0 auto;
      padding: 0 32px;
    }

    .rl-logo {
      justify-self: start;
      display: flex;
      width: 36px;
      height: 36px;
    }

    .rl-logo img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    .rl-social svg {
      width: 100%;
      height: 100%;
      fill: currentColor;
    }

    .rl-nav {
      display: flex;
      gap: 32px;
    }

    .rl-nav a,
    .rl-footer-nav a {
      padding: 4px 0;
      font-size: 15px;
      line-height: 1.4;
      color: #ffffff;
      border-bottom: 1px solid transparent;
      transition: border-color .2s ease, opacity .2s ease;
    }

    .rl-nav a[aria-current="page"],
    .rl-footer-nav a[aria-current="page"] {
      border-bottom-color: #ffffff;
    }

    @media (hover: hover) and (pointer: fine) {
      .rl-nav a:hover,
      .rl-footer-nav a:hover {
        border-bottom-color: #ffffff;
      }
    }

    .rl-social {
      display: flex;
      width: 28px;
      height: 28px;
      color: #ffffff;
    }

    .rl-header .rl-social {
      justify-self: end;
    }

    .rl-footer {
      margin-top: 96px;
      padding: 48px 32px calc(28px + env(safe-area-inset-bottom));
    }

    .rl-footer-inner {
      max-width: 1280px;
      margin: 0 auto;
    }

    .rl-footer-nav {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 12px 32px;
    }

    .rl-footer-bottom {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 40px;
      padding-top: 24px;
      border-top: 1px solid rgba(255, 255, 255, .16);
      font-size: 13px;
      color: rgba(255, 255, 255, .6);
    }

    .rl-footer .rl-social {
      width: 22px;
      height: 22px;
    }

    @media (max-width: 640px) {

      .rl-header-inner {
        grid-template-columns: 1fr auto;
        grid-template-areas:
          "logo social"
          "nav  nav";
        height: auto;
        padding: 12px 20px 0;
        row-gap: 4px;
      }

      .rl-logo { grid-area: logo; width: 30px; height: 30px; }
      .rl-header .rl-social { grid-area: social; width: 24px; height: 24px; }

      .rl-nav {
        grid-area: nav;
        justify-content: space-between;
        gap: 12px;
        padding-bottom: 10px;
      }

      .rl-nav a { font-size: 13px; }

      .rl-footer { margin-top: 64px; padding: 40px 20px calc(24px + env(safe-area-inset-bottom)); }
      .rl-footer-nav { gap: 10px 24px; }
      .rl-footer-bottom { flex-direction: column-reverse; gap: 16px; }
    }

</style>

</head>


